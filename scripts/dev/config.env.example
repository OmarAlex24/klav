# The build scripts' local settings (docs/ios.md §5, scripts/dev/local-config.sh).
# Copy it to ~/.config/klav-dev/config.env (or $XDG_CONFIG_HOME/klav-dev/,
# or the path in KLAV_DEV_CONFIG), outside any checkout, and keep only the
# lines you need. One NAME=value per line; the value is taken as written:
# no quotes, no $HOME, no ~. A variable set in the environment, and not
# empty, wins.

# DerivedData and the Swift package cache. Without them they go in
# target/xcode/ of the checkout.
KLAV_IOS_DERIVED=/path/to/build/klav-ios-derived
KLAV_MAC_DERIVED=/path/to/build/klav-mac-derived
KLAV_MAC_RELEASE_DERIVED=/path/to/build/klav-mac-release-derived
KLAV_SPM_CACHE=/path/to/build/klav-spm-cache

# Only for scripts/macos/build-app.sh release, which stops without them:
# the App Store Connect API key (its path, never its contents), its key ID
# and its issuer ID.
KLAV_NOTARY_KEY=/path/to/AuthKey_XXXXXXXXXX.p8
KLAV_NOTARY_KEY_ID=XXXXXXXXXX
KLAV_NOTARY_ISSUER=00000000-0000-0000-0000-000000000000
