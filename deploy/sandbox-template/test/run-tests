# The copy the tests run, with check-template and klav-tailnet-up next to it
# as the person copies the folder: the shipped files, the seam pointing at
# the case's fakes and at the case's root.
build_copy() { # case dir
	local c=$1
	sed -e "s|^bin_path=.*|bin_path=$c/bin|" -e "s|^root=\$|root=$c/root|" "$shipped_build" >"$c/build-template"
	if ! "$REAL_GREP" -qxF "bin_path=$c/bin" "$c/build-template" || ! "$REAL_GREP" -qxF "root=$c/root" "$c/build-template"; then
		echo "the seam rewrite of build-template did not apply: refusing to run" >&2
		exit 1
	fi
	cmp -s <(sed "${seam_re}d" "$shipped_build") <(sed "${seam_re}d" "$c/build-template") || {
		echo "the copy of build-template differs from the shipped file outside the seam" >&2
		exit 1
	}
	"$REAL_CP" "$src/check-template" "$src/klav-tailnet-up" "$c/"
}

