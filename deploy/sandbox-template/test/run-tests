# The whole run, as root, against fakes that act: the install commands
# write only inside the case's root (and refuse anything else), systemctl
# keeps the unit's state, and check-template runs last on that root.
# shellcheck disable=SC2016 # expanded by the fake
CURL_BODY='
out=
url=
while [ "$#" -gt 0 ]; do
	case $1 in
	-o) out=$2; shift 2 ;;
	--proto) shift 2 ;;
	-*) shift ;;
	*) url=$1; shift ;;
	esac
done
case $out in "$KLAV_TEST_CASE"/*) ;; *) printf "curl %s\n" "$out" >>"$KLAV_TEST_CASE/outside"; exit 99 ;; esac
case $url in
https://pkgs.tailscale.com/*.noarmor.gpg) cat "$KLAV_TEST_CASE/keyring" >"$out" ;;
*) exit 22 ;;
esac'
# shellcheck disable=SC2016 # expanded by the fake
INSTALL_BODY='
mode=
args=()
while [ "$#" -gt 0 ]; do
	case $1 in
	-o | -g) shift 2 ;;
	-m) mode=$2; shift 2 ;;
	*) args+=("$1"); shift ;;
	esac
done
[ "${#args[@]}" = 2 ] && [ -n "$mode" ] || exit 64
case ${args[1]} in "$KLAV_TEST_CASE"/*) ;; *) printf "install %s\n" "${args[1]}" >>"$KLAV_TEST_CASE/outside"; exit 99 ;; esac
cp "${args[0]}" "${args[1]}"
chmod "$mode" "${args[1]}"'
# apt-get: `update` writes a package list that names `boat_`, as Ubuntu's
# universe list does.
# shellcheck disable=SC2016 # expanded by the fake
APT_GET_BODY='
[ "$1" = update ] || exit 0
lists=$KLAV_TEST_CASE/root/var/lib/apt/lists
mkdir -p "$lists/partial"
printf "Filename: pool/universe/x/xboat/xboat_1.0_amd64.deb\n" >"$lists/archive_dists_noble_universe_binary-amd64_Packages"'
# journalctl --rotate: each active journal file becomes an archived one
# (name@...) and a new, empty one takes its place; fails with
# `journal_fails`.
# shellcheck disable=SC2016 # expanded by the fake
JOURNALCTL_BODY='
[ "$*" = --rotate ] || exit 64
[ ! -e "$KLAV_TEST_CASE/journal_fails" ] || exit 1
for f in "$KLAV_TEST_CASE"/root/var/log/journal/*/*.journal; do
	[ -e "$f" ] || continue
	case ${f##*/} in *@*) continue ;; esac
	mv "$f" "${f%.journal}@0001-rotated.journal"
	printf "journal started\n" >"$f"
done'
# truncate -s 0 -- FILE...: only inside the case; fails with
# `truncate_fails`.
# shellcheck disable=SC2016 # expanded by the fake
TRUNCATE_BODY='
[ ! -e "$KLAV_TEST_CASE/truncate_fails" ] || exit 1
[ "$1" = -s ] && [ "$2" = 0 ] && [ "$3" = -- ] || exit 64
shift 3
for f in "$@"; do
	case $f in "$KLAV_TEST_CASE"/*) ;; *) printf "truncate %s\n" "$f" >>"$KLAV_TEST_CASE/outside"; exit 99 ;; esac
	: >"$f"
done'
build_bin_full() { # bin
	local b=$1
	"$REAL_MKDIR" -p "$b"
	fake "$b" id 'echo 0'
	fake "$b" apt-get "$APT_GET_BODY"
	fake "$b" apt-mark 'exit 0'
	fake "$b" npm '[ "$*" != "prefix -g" ] || echo /usr/local'
	fake "$b" journalctl "$JOURNALCTL_BODY"
	fake "$b" truncate "$TRUNCATE_BODY"
	fake "$b" tailscale 'echo 1.0.0'
	fake "$b" jq 'echo jq-1.0'
	fake "$b" pgrep 'exit 1'
	fake "$b" systemctl "$SYSTEMCTL_BODY"
	fake "$b" ls "$LS_BODY"
	fake "$b" curl "$CURL_BODY"
	fake "$b" install "$INSTALL_BODY"
	guarded "$b" rm "$REAL_RM"
	guarded "$b" mv "$(real mv)"
	guarded "$b" mkdir "$REAL_MKDIR"
	guarded "$b" chmod "$(real chmod)"
	wrap "$b" sha256sum "$REAL_SHA"
	wrap "$b" md5sum "$REAL_MD5"
	wrap "$b" dirname "$(real dirname)"
	wrap "$b" head "$(real head)"
	wrap "$b" grep "$REAL_GREP"
	wrap "$b" find "$(real find)"
	wrap "$b" xargs "$(real xargs)"
}
BUILD_FULL_COMMANDS="id apt-get apt-mark npm tailscale jq pgrep systemctl ls curl install rm mv mkdir chmod sha256sum md5sum dirname head grep find xargs klav-forward journalctl truncate"
# A machine as the person starts it: Debian, the unit enabled by the
# package, and state left in /var/lib/tailscale.
full_build_case() { # name
	build_case "$1" "$COMMIT"
	"$REAL_RM" -rf "$CASE/bin"
	build_bin_full "$CASE/bin"
	local r=$CASE/root
	"$REAL_MKDIR" -p "$r/etc/apt/sources.list.d" "$r/usr/share/keyrings" "$r/usr/local/bin" \
		"$r/usr/local/sbin" "$r/var/lib/tailscale" "$r/var/lib/dpkg/info" "$r/root" "$r/home/user"
	printf 'ID=debian\nVERSION_CODENAME=bookworm\n' >"$r/etc/os-release"
	printf 'old state\n' >"$r/var/lib/tailscale/tailscaled.state"
	printf 'enabled\n' >"$CASE/unit"
	# The logs of the person's commands on the build machine, one of which
	# named a string, and an old package list.
	"$REAL_MKDIR" -p "$r/var/log/apt" "$r/var/log/journal/m1" "$r/var/lib/apt/lists"
	printf 'sudo: COMMAND=/usr/bin/grep -r boat_ /root\n' >"$r/var/log/auth.log"
	printf 'Commandline: apt-get install xboat_1\n' >"$r/var/log/apt/history.log"
	printf 'grep boat_\n' >"$r/var/log/journal/m1/system.journal"
	printf 'grep boat_\n' >"$r/var/log/journal/m1/user-1000.journal"
	printf 'grep boat_\n' >"$r/var/log/journal/m1/user-1000@0000-old.journal"
	printf 'old list\n' >"$r/var/lib/apt/lists/old_Packages"
}
run_full_build() {
	run_build --manifest "$CASE/manifest" --forward "$CASE/klav-forward"
}
nothing_outside() { test ! -e "$CASE/outside"; }

full_build_case "a whole build"
run_full_build
check "exit 0 ($CODE)" test "$CODE" = 0
check "says it may be saved, by name" "$REAL_GREP" -qxF "build-template: klav-sandbox-0.9.0 is ready. Save this machine as klav-sandbox-0.9.0 from your own machine." "$CASE/out"
check "the keyring over https only, into a side file" contains "$CASE/calls" "curl -fsSL --proto =https https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg -o $CASE/root/usr/share/keyrings/tailscale-archive-keyring.gpg.new"
check "the checked keyring in place" cmp -s "$CASE/keyring" "$CASE/root/usr/share/keyrings/tailscale-archive-keyring.gpg"
check "no side file left" test ! -e "$CASE/root/usr/share/keyrings/tailscale-archive-keyring.gpg.new"
# The apt list is the script's own line, never a download: `signed-by` is
# what ties apt to the checked keyring.
check "the apt list names the keyring" "$REAL_GREP" -qxF 'deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/debian bookworm main' "$CASE/root/etc/apt/sources.list.d/tailscale.list"
check "the apt list is one line" test "$(wc -l <"$CASE/root/etc/apt/sources.list.d/tailscale.list" | tr -d ' ')" = 1
check "one download, the keyring" test "$("$REAL_GREP" -c '^curl ' "$CASE/calls")" = 1
check "the exact versions" contains "$CASE/calls" "apt-get install -y tailscale=1.0.0 jq=1.0-1"
check "held" contains "$CASE/calls" "apt-mark hold tailscale jq"
check "the unit stopped" contains "$CASE/calls" "systemctl disable --now tailscaled.service"
check "the unit masked" contains "$CASE/calls" "systemctl mask tailscaled.service"
check "the unit is masked" test "$(cat "$CASE/unit")" = masked
check "no Tailscale state" test -z "$("$REAL_LS" -A "$CASE/root/var/lib/tailscale")"
check "each npm CLI at its version" contains "$CASE/calls" "npm install -g @example/cli@1.2.3"
check "each npm CLI at its version (2)" contains "$CASE/calls" "npm install -g other-cli@0.1.0"
check "klav-forward installed" test "$(sha_of "$CASE/root/usr/local/bin/klav-forward")" = "$FORWARD_SHA"
check "klav-tailnet-up installed" cmp -s "$shipped" "$CASE/root/usr/local/sbin/klav-tailnet-up"
check "klav-tailnet-up 0755" test "$("$REAL_LS" -l "$CASE/root/usr/local/sbin/klav-tailnet-up" | cut -c1-10)" = -rwxr-xr-x
check "the record has klav-forward's hash" "$REAL_GREP" -qx "KLAV_FORWARD_SHA256=$FORWARD_SHA" "$CASE/root/etc/klav-sandbox-template/manifest"
check "the record has klav-tailnet-up's hash" "$REAL_GREP" -qx "KLAV_TAILNET_UP_SHA256=$(sha_of "$shipped")" "$CASE/root/etc/klav-sandbox-template/manifest"
check "check-template ran last, on that root" contains "$CASE/calls" "systemctl is-enabled tailscaled.service"
check "check-template's checks passed" contains "$CASE/out" "check-template: nothing forbidden found"
check "the record says where npm put the CLIs" "$REAL_GREP" -qx "NPM_GLOBAL_PREFIX=/usr/local" "$CASE/root/etc/klav-sandbox-template/manifest"
check "no allow list, none recorded" lacks "$CASE/root/etc/klav-sandbox-template/manifest" "ALLOW="
check "apt's package lists removed" test -z "$("$REAL_LS" -A "$CASE/root/var/lib/apt/lists")"
check "the journal rotated" contains "$CASE/calls" "journalctl --rotate"
check "the archived journal files removed" test -z "$("$REAL_LS" "$CASE/root/var/log/journal/m1" | "$REAL_GREP" '@' || true)"
check "a new journal file in place, never emptied" test -s "$CASE/root/var/log/journal/m1/system.journal"
check "sudo's log emptied" test ! -s "$CASE/root/var/log/auth.log"
check "apt's log emptied" test ! -s "$CASE/root/var/log/apt/history.log"
check "the logs emptied before the check" test "$("$REAL_GREP" -n -m1 '^truncate ' "$CASE/calls" | cut -d: -f1)" -lt "$("$REAL_GREP" -n -m1 '^systemctl is-enabled' "$CASE/calls" | cut -d: -f1)"
check "nothing written outside the case" nothing_outside
check "only fakes ran" guard "$CASE" "$BUILD_FULL_COMMANDS"

full_build_case "the unit is not masked"
: >"$CASE/mask_noop"
run_full_build
check "exit 1 ($CODE)" test "$CODE" = 1
