#!/bin/bash
# Tests of deploy/sandbox-template (ADR 0042 §10, row 3): klav-tailnet-up,
# check-template and build-template, against fakes only.
#
# Shell: bash, 3.2 or later. Needs, already installed: jq, sha256sum,
# md5sum, python3 or node (to make a Unix socket), and the usual tools
# (mktemp, rm, mv, sleep, grep, sed, cmp, env, ls, cp, chmod, find, xargs,
# printenv). It installs nothing.
#
#   deploy/sandbox-template/test/run-tests
#   KLAV_TEST_BASH=/bin/bash deploy/sandbox-template/test/run-tests
#
# KLAV_TEST_BASH picks the bash that runs the scripts under test (default:
# the bash on PATH).
#
# Never a real tool that matters: every script under test runs with a PATH
# that holds only fakes (tailscale, tailscaled, systemd-run, systemctl,
# sudo, pgrep, id, apt-get, curl, npm, install...) and logging wrappers
# around a few plain tools. klav-tailnet-up and build-template fix their
# own PATH, so the tests run copies whose test seams (marked lines) point
# at the fakes and at the case's own directory; neither shipped file runs
# here. A guard fails a case if a script under test executed anything that
# is not one of those, and the wrappers that write refuse any path outside
# the case's directory.

set -eu
set -o pipefail
IFS=$' \t\n'

here=$(cd "$(dirname "$0")" && pwd)
src=$(dirname "$here")
bash_under_test=$(command -v "${KLAV_TEST_BASH:-bash}") || {
	echo "no bash at ${KLAV_TEST_BASH:-bash}" >&2
	exit 1
}

# The real plain tools, resolved once, before any PATH is narrowed.
real() {
	command -v "$1" || {
		echo "run-tests needs $1" >&2
		exit 1
	}
}
REAL_BASH=$(real bash)
REAL_ENV=$(real env)
REAL_JQ=$(real jq)
REAL_MKTEMP=$(real mktemp)
REAL_RM=$(real rm)
REAL_SLEEP=$(real sleep)
REAL_GREP=$(real grep)
REAL_LS=$(real ls)
REAL_SHA=$(real sha256sum)
REAL_MKDIR=$(real mkdir)
REAL_MD5=$(real md5sum)
REAL_CP=$(real cp)
socket_tool=${KLAV_TEST_SOCKET_TOOL:-}
if [ -z "$socket_tool" ]; then
	if command -v python3 >/dev/null 2>&1; then socket_tool=python3; else socket_tool=node; fi
fi
if [ "$socket_tool" = python3 ] && command -v python3 >/dev/null 2>&1; then
	MKSOCK="$(command -v python3) -I -c 'import socket,sys; socket.socket(socket.AF_UNIX).bind(sys.argv[1])'"
elif [ "$socket_tool" = node ] && command -v node >/dev/null 2>&1; then
	MKSOCK="$(command -v node) -e 'require(\"net\").createServer().listen(process.argv[1], () => process.exit(0))'"
else
	echo "run-tests needs python3 or node to make a Unix socket" >&2
	exit 1
fi

# Short paths: a Unix socket's path has at most 104 bytes on macOS.
tmp=$("$REAL_MKTEMP" -d /tmp/kst.XXXXXX)
cleanup() { "$REAL_RM" -rf -- "$tmp"; }
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# The only tools a fake itself may use: links to plain ones.
PLAIN=$tmp/plain
"$REAL_MKDIR" -p "$PLAIN"
for t in cat cut ls grep mkdir env sha256sum cp chmod mv; do
	ln -s "$(real "$t")" "$PLAIN/$t"
done

passed=0
failed=0
current=
pass() { passed=$((passed + 1)); }
fail() {
	failed=$((failed + 1))
	printf 'FAIL %s: %s\n' "$current" "$1" >&2
}
check() { # description, command...
	local what=$1
	shift
	if "$@"; then pass; else fail "$what"; fi
}
contains() { "$REAL_GREP" -qF -- "$2" "$1"; }
lacks() { ! "$REAL_GREP" -rqsF -- "$2" "$1"; }

# --- Fakes and wrappers -----------------------------------------------------

# A logging wrapper around a real tool: one line per run, its name and
# arguments, in the case's log, a newline in an argument written as \n.
wrap() { # bin, name, real path
	cat >"$1/$2" <<EOF
#!$REAL_BASH
args="\$*"
printf '%s\n' "$2 \${args//\$'\n'/\\\\n}" >>"\$KLAV_TEST_CASE/calls"
exec "$3" "\$@"
EOF
	chmod 0755 "$1/$2"
}

# A logging wrapper that refuses, before running the real tool, any
# absolute path argument outside the case's directory.
guarded() { # bin, name, real path
	cat >"$1/$2" <<EOF
#!$REAL_BASH
printf '%s\n' "$2 \$*" >>"\$KLAV_TEST_CASE/calls"
for a in "\$@"; do
	case \$a in
	/*) case \$a in "\$KLAV_TEST_CASE"/*) ;; *)
		printf '%s\n' "$2 \$a" >>"\$KLAV_TEST_CASE/outside"
		exit 99 ;;
	esac ;;
	esac
done
exec "$3" "\$@"
EOF
	chmod 0755 "$1/$2"
}

# A fake: logs its arguments and its environment, then runs its body.
fake() { # bin, name, body
	cat >"$1/$2" <<EOF
#!$REAL_BASH
set -eu
PATH=$PLAIN
n=\$("$REAL_LS" "\$KLAV_TEST_CASE" | "$REAL_GREP" -c '^env\.' || true)
"$REAL_ENV" >"\$KLAV_TEST_CASE/env.\$n.$2"
printf '%s\n' "$2 \$*" >>"\$KLAV_TEST_CASE/calls"
$3
EOF
	chmod 0755 "$1/$2"
}

# The fakes of klav-tailnet-up. State in files of the case directory:
#   state     down | tagged | untagged (what `status --json` says)
#   after_up  the state after a successful `up`
#   up_exit   the exit code of `up`
#   no_socket tailscaled never opens its socket
tailnet_bin() {
	local bin=$1
	"$REAL_MKDIR" -p "$bin"
	fake "$bin" tailscale "
sock=
for a in \"\$@\"; do case \$a in --socket=*) sock=\${a#--socket=} ;; esac; done
[ -n \"\$sock\" ] || { echo 'no --socket' >&2; exit 64; }
sub=
for a in \"\$@\"; do case \$a in --*) ;; *) sub=\$a; break ;; esac; done
state=\$(cat \"\$KLAV_TEST_CASE/state\")
case \$sub in
status)
	case \$state in
	down) echo 'failed to connect to local tailscaled' >&2; exit 1 ;;
	tagged) echo '{\"BackendState\":\"Running\",\"Self\":{\"Tags\":[\"tag:klav-sandbox\"]}}' ;;
	untagged) echo '{\"BackendState\":\"Running\",\"Self\":{\"Tags\":[\"tag:other\"]}}' ;;
	esac ;;
up)
	file=
	for a in \"\$@\"; do case \$a in --auth-key=file:*) file=\${a#--auth-key=file:} ;; esac; done
	if [ -n \"\$file\" ] && [ -f \"\$file\" ]; then
		printf 'key-file %s\n' \"\$file\" >>\"\$KLAV_TEST_CASE/seen\"
		\"$REAL_LS\" -ln \"\$file\" | cut -c1-10 >>\"\$KLAV_TEST_CASE/seen\"
		\"$REAL_SHA\" <\"\$file\" | cut -d' ' -f1 >>\"\$KLAV_TEST_CASE/seen\"
	else
		echo 'no key file' >>\"\$KLAV_TEST_CASE/seen\"
	fi
	code=\$(cat \"\$KLAV_TEST_CASE/up_exit\")
	[ \"\$code\" != 0 ] || cat \"\$KLAV_TEST_CASE/after_up\" >\"\$KLAV_TEST_CASE/state\"
	exit \"\$code\" ;;
logout) echo down >\"\$KLAV_TEST_CASE/state\" ;;
*) echo \"unexpected: \$*\" >&2; exit 64 ;;
esac"
	fake "$bin" tailscaled "
sock=
for a in \"\$@\"; do case \$a in --socket=*) sock=\${a#--socket=} ;; esac; done
[ -n \"\$sock\" ] || exit 64
[ ! -e \"\$KLAV_TEST_CASE/no_socket\" ] || exit 0
\"$REAL_MKDIR\" -p \"\${sock%/*}\"
$MKSOCK \"\$sock\""
	# systemd-run: starts the unit's command (here, the fake tailscaled) and
	# returns, as a transient service does; fails with `systemd_fails`.
	# shellcheck disable=SC2016 # expanded by the fake
	fake "$bin" systemd-run '
[ ! -e "$KLAV_TEST_CASE/systemd_fails" ] || exit 1
while [ "$#" -gt 0 ] && [ "$1" != -- ]; do shift; done
[ "$#" -gt 1 ] || exit 64
shift
"$@"'
	wrap "$bin" jq "$REAL_JQ"
	wrap "$bin" mktemp "$REAL_MKTEMP"
	wrap "$bin" rm "$REAL_RM"
	wrap "$bin" sleep "$REAL_SLEEP"
}

# Everything klav-tailnet-up may execute: the guard checks the calls log
# against this, and that the script names no command by absolute path.
TAILNET_COMMANDS="tailscale tailscaled systemd-run jq mktemp rm sleep"

guard() { # case dir, allowed command names
	local name
	while IFS=' ' read -r name _; do
		case " $2 " in *" $name "*) ;; *) return 1 ;; esac
	done <"$1/calls"
	return 0
}

# --- klav-tailnet-up --------------------------------------------------------

shipped=$src/klav-tailnet-up
current="seam"
seam_re='/^# klav-test-seam: begin/,/^# klav-test-seam: end/'
# The shipped seam holds exactly these values.
check "the shipped seam's PATH" "$REAL_GREP" -qx 'bin_path=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' "$shipped"
check "the shipped seam's run directory" "$REAL_GREP" -qx 'run_dir=/run' "$shipped"
check "the shipped seam's socket wait" "$REAL_GREP" -qx 'socket_wait=30' "$shipped"
check "one seam, three assignments" test "$(sed -n "${seam_re}p" "$shipped" | "$REAL_GREP" -c '^[a-z_]*=')" = 3
# Nothing outside the seam names a command by absolute path.
check "no absolute command paths" test -z "$(sed "${seam_re}d" "$shipped" | "$REAL_GREP" -vE '^[[:space:]]*#' | "$REAL_GREP" -E '(^|[[:space:];|&(])/(usr|bin|sbin|opt)/' || true)"

# The copy the tests run: the shipped file with only the seam's values
# changed. Proven by comparing both without the seam block.
tailnet_copy() { # case dir -> path of the copy
	local case=$1 copy=$1/klav-tailnet-up
	sed -e "s|^bin_path=.*|bin_path=$case/bin|" \
		-e "s|^run_dir=.*|run_dir=$case/run|" \
		-e 's|^socket_wait=.*|socket_wait=3|' "$shipped" >"$copy"
	# The rewrite applied: the copy must not reach a real tool.
	if "$REAL_GREP" -q '^bin_path=/usr' "$copy" || "$REAL_GREP" -qx 'run_dir=/run' "$copy"; then
		echo "the seam rewrite did not apply: refusing to run" >&2
		exit 1
	fi
	cmp -s <(sed "${seam_re}d" "$shipped") <(sed "${seam_re}d" "$copy") || {
		echo "the copy differs from the shipped file outside the seam" >&2
		exit 1
	}
	printf '%s\n' "$copy"
}

KEY=tskey-auth-kTESTFAKE0123-ZZsecretpartAB9876
KEY_SHA=$(printf '%s' "$KEY" | "$REAL_SHA" | cut -d' ' -f1)
HOST=klav-e3d1bf79
n=0

# A new case directory with the fakes, in a given state.
new_case() { # name, state, after_up, up_exit
	n=$((n + 1))
	current="klav-tailnet-up: $1"
	CASE=$tmp/t$n
	"$REAL_MKDIR" -p "$CASE/run"
	: >"$CASE/calls"
	printf '%s\n' "$2" >"$CASE/state"
	printf '%s\n' "$3" >"$CASE/after_up"
	printf '%s\n' "$4" >"$CASE/up_exit"
	tailnet_bin "$CASE/bin"
	COPY=$(tailnet_copy "$CASE")
}

# Runs the copy in an empty environment, as sudo would, with stdin from a
# file; extra `env` assignments come first.
run_tailnet() { # stdin file, then env assignments and args after --
	local input=$1
	shift
	local envs=()
	while [ "$#" -gt 0 ] && [ "$1" != -- ]; do
		envs+=("$1")
		shift
	done
	shift
	set +e
	"$REAL_ENV" -i KLAV_TEST_CASE="$CASE" ${envs[@]+"${envs[@]}"} \
		"$bash_under_test" "$COPY" "$@" <"$input" >"$CASE/out" 2>"$CASE/err"
	CODE=$?
	set -e
}

key_input() { printf '%s\n' "$KEY" >"$CASE/key.in"; }
no_leftover() {
	local left=("$CASE"/run/klav-tailnet.*)
	[ ! -e "${left[0]}" ]
}
# The key is nowhere: not in any argument, environment, output or file of
# the case except the input the test wrote.
key_nowhere() {
	"$REAL_RM" -f "$CASE/key.in"
	lacks "$CASE" "$KEY"
}
up_args() { "$REAL_GREP" '^tailscale .* up ' "$CASE/calls" || true; }

# 1. The key is never an argument; the happy path.
new_case "joins, and the key is never an argument" down tagged 0
key_input
run_tailnet "$CASE/key.in" -- "$HOST"
check "exit 0 ($CODE)" test "$CODE" = 0
check "tailscaled as a transient systemd unit, not a child" contains "$CASE/calls" "systemd-run --unit=klav-tailscaled --collect --quiet -- $CASE/bin/tailscaled --state=mem: --socket=$CASE/run/tailscale/tailscaled.sock"
check "tailscaled with its state in memory" contains "$CASE/calls" "tailscaled --state=mem: --socket=$CASE/run/tailscale/tailscaled.sock"
check "up with the file, hostname, no DNS, no routes, a timeout" test "$(up_args)" = "tailscale --socket=$CASE/run/tailscale/tailscaled.sock up --auth-key=file:$(sed -n 's/^key-file //p' "$CASE/seen") --hostname=$HOST --accept-dns=false --accept-routes=false --timeout=60s"
check "the key file sat in a new directory under the run directory" "$REAL_GREP" -q "^key-file $CASE/run/klav-tailnet\.[A-Za-z0-9]*/key$" "$CASE/seen"
check "the key file was 0600" "$REAL_GREP" -qx -- '-rw-------' "$CASE/seen"
check "the key file held the key" "$REAL_GREP" -qx "$KEY_SHA" "$CASE/seen"
check "no key file left" no_leftover
check "says it joined" contains "$CASE/out" "on the tailnet as $HOST, with tag:klav-sandbox"
check "only fakes ran" guard "$CASE" "$TAILNET_COMMANDS"
check "the key in no argument, environment, output or file" key_nowhere

# The same under `bash -x`: the trace stops before the key is read.
new_case "a trace never shows the key" down tagged 0
key_input
set +e
"$REAL_ENV" -i KLAV_TEST_CASE="$CASE" "$bash_under_test" -x "$COPY" "$HOST" \
	<"$CASE/key.in" >"$CASE/out" 2>"$CASE/err"
CODE=$?
set -e
check "exit 0 ($CODE)" test "$CODE" = 0
check "the trace stopped" test "$(wc -l <"$CASE/err")" -le 4
check "the key in no trace" key_nowhere

# The environment changes nothing it runs or where it writes.
new_case "the caller's environment cannot redirect it" down tagged 0
key_input
"$REAL_MKDIR" -p "$CASE/evil"
# shellcheck disable=SC2016 # expanded by the fake
fake "$CASE/evil" tailscale 'echo EVIL >>"$KLAV_TEST_CASE/evil.ran"'
# shellcheck disable=SC2016 # expanded by the fake
fake "$CASE/evil" tailscaled 'echo EVIL >>"$KLAV_TEST_CASE/evil.ran"'
run_tailnet "$CASE/key.in" PATH="$CASE/evil" bin_path="$CASE/evil" run_dir="$CASE/evil" socket_wait=0 -- "$HOST"
check "exit 0 ($CODE)" test "$CODE" = 0
check "no evil command ran" test ! -e "$CASE/evil.ran"
check "nothing written in the evil directory" test -z "$("$REAL_LS" -A "$CASE/evil" | "$REAL_GREP" -v '^tailscale' || true)"
check "the key nowhere" key_nowhere

# 2. `up` fails: the key file is removed, and nothing else runs.
new_case "up fails: the key file is removed" down tagged 1
key_input
run_tailnet "$CASE/key.in" -- "$HOST"
check "a non-zero exit ($CODE)" test "$CODE" != 0
check "up had the key file" "$REAL_GREP" -qx "$KEY_SHA" "$CASE/seen"
check "no key file left" no_leftover
check "no logout" test -z "$("$REAL_GREP" ' logout' "$CASE/calls" || true)"
check "only fakes ran" guard "$CASE" "$TAILNET_COMMANDS"
check "the key nowhere" key_nowhere

# 3. The socket wait: tailscaled never opens it.
new_case "the socket never comes" down tagged 0
key_input
: >"$CASE/no_socket"
start=$SECONDS
run_tailnet "$CASE/key.in" -- "$HOST"
check "exit 1 ($CODE)" test "$CODE" = 1
check "it waited, and not forever" test "$((SECONDS - start))" -le 8
check "says why" contains "$CASE/err" "tailscaled did not open its socket within 3 s"
check "never called up" test -z "$(up_args)"
check "no key file left" no_leftover
check "the key nowhere" key_nowhere

# systemd cannot start the unit: exit 1, never up.
new_case "systemd cannot start tailscaled" down tagged 0
key_input
: >"$CASE/systemd_fails"
run_tailnet "$CASE/key.in" -- "$HOST"
check "exit 1 ($CODE)" test "$CODE" = 1
check "says why" contains "$CASE/err" "systemd could not start tailscaled"
check "never called up" test -z "$(up_args)"
check "no key file left" no_leftover
check "only fakes ran" guard "$CASE" "$TAILNET_COMMANDS"
check "the key nowhere" key_nowhere

# A socket already there: no second tailscaled.
new_case "a running tailscaled is used" down tagged 0
key_input
"$REAL_MKDIR" -p "$CASE/run/tailscale"
eval "$MKSOCK \"\$CASE/run/tailscale/tailscaled.sock\""
run_tailnet "$CASE/key.in" -- "$HOST"
check "exit 0 ($CODE)" test "$CODE" = 0
check "no tailscaled started" test -z "$("$REAL_GREP" -E '^(tailscaled|systemd-run) ' "$CASE/calls" || true)"
check "up ran with its timeout" contains "$CASE/calls" "--timeout=60s"

# 4. A node without the tag: logout, exit 1.
new_case "a missing tag logs out" down untagged 0
key_input
run_tailnet "$CASE/key.in" -- "$HOST"
check "exit 1 ($CODE)" test "$CODE" = 1
check "logged out" "$REAL_GREP" -q '^tailscale .* logout$' "$CASE/calls"
check "says why" contains "$CASE/err" "joined without tag:klav-sandbox"
check "no key file left" no_leftover
check "the key nowhere" key_nowhere

# 5. An empty input: skipped, exit 0, nothing called.
for input in empty newline; do
	new_case "an empty input skips ($input)" down tagged 0
	if [ "$input" = empty ]; then : >"$CASE/key.in"; else printf '\n' >"$CASE/key.in"; fi
	run_tailnet "$CASE/key.in" -- ""
	check "exit 0 ($CODE)" test "$CODE" = 0
	check "says it skipped" contains "$CASE/out" "no Tailscale key: skipped"
	check "no tailscale, no tailscaled" test -z "$("$REAL_GREP" '^tailscale' "$CASE/calls" || true)"
	check "no key file left" no_leftover
done

# A hostname with an empty input: the key made for this sandbox did not
# arrive, which is an error, never a skip.
for input in empty newline; do
	new_case "a hostname but no key ($input)" down tagged 0
	if [ "$input" = empty ]; then : >"$CASE/key.in"; else printf '\n' >"$CASE/key.in"; fi
	run_tailnet "$CASE/key.in" -- "$HOST"
	check "exit 2 ($CODE)" test "$CODE" = 2
	check "says why" contains "$CASE/err" "a hostname but no Tailscale key: refused"
	check "never says it skipped" lacks "$CASE/out" "skipped"
	check "no tailscale, no tailscaled" test -z "$("$REAL_GREP" '^tailscale' "$CASE/calls" || true)"
	check "no key file left" no_leftover
done

# 6. Already up with the tag: a rerun with a spent key.
new_case "already up: a rerun" tagged tagged 1
key_input
run_tailnet "$CASE/key.in" -- "$HOST"
check "exit 0 ($CODE)" test "$CODE" = 0
check "says so" contains "$CASE/out" "already on the tailnet with tag:klav-sandbox"
check "never called up" test -z "$(up_args)"
check "no tailscaled started" test -z "$("$REAL_GREP" -E '^(tailscaled|systemd-run) ' "$CASE/calls" || true)"
check "no key file left" no_leftover
check "the key nowhere" key_nowhere

# Up with another tag only: not a rerun, it joins.
new_case "up without the tag is not a rerun" untagged tagged 0
key_input
"$REAL_MKDIR" -p "$CASE/run/tailscale"
eval "$MKSOCK \"\$CASE/run/tailscale/tailscaled.sock\""
run_tailnet "$CASE/key.in" -- "$HOST"
check "exit 0 ($CODE)" test "$CODE" = 0
check "called up" test -n "$(up_args)"

# The setup line as the README documents it, run as a setup script would
# (`set -euo pipefail`, an empty environment, a PATH of fakes), with a fake
# sudo that accepts exactly the documented arguments and runs the copy.
current="the documented setup line"
SETUP_LINE=$("$REAL_GREP" -E '^ *\{ printenv KLAV_TAILNET_KEY' "$src/README.md" | sed 's/^ *//' || true)
check "the README has one setup line" test "$(printf '%s\n' "$SETUP_LINE" | wc -l | tr -d ' ')" = 1
# shellcheck disable=SC2016 # the line's text, expanded by the setup script
check "it tolerates a missing key and hostname" test "$SETUP_LINE" = '{ printenv KLAV_TAILNET_KEY || true; } | sudo -n /usr/local/sbin/klav-tailnet-up "${KLAV_TAILNET_HOSTNAME:-}"'
check "klav-tailnet-up's header gives the same line" "$REAL_GREP" -qxF "#   $SETUP_LINE" "$shipped"
check "ADR 0042 gives the same line" "$REAL_GREP" -qF "$SETUP_LINE" "$src/../../docs/decisiones/0042-sandboxes-for-daily-use.md"
setup_bin() {
	wrap "$CASE/bin" printenv "$(real printenv)"
	fake "$CASE/bin" sudo "
[ \"\$#\" = 3 ] && [ \"\$1\" = -n ] && [ \"\$2\" = /usr/local/sbin/klav-tailnet-up ] || exit 64
exec $REAL_ENV -i KLAV_TEST_CASE=\"\$KLAV_TEST_CASE\" \"$bash_under_test\" \"$COPY\" \"\$3\""
}
run_setup() { # env assignments...
	set +e
	"$REAL_ENV" -i KLAV_TEST_CASE="$CASE" PATH="$CASE/bin" "$@" \
		"$bash_under_test" -c "set -euo pipefail; $SETUP_LINE" </dev/null >"$CASE/out" 2>"$CASE/err"
	CODE=$?
	set -e
}
new_case "the setup line without a tailnet" down tagged 0
setup_bin
run_setup
check "exit 0 ($CODE)" test "$CODE" = 0
check "says it skipped" contains "$CASE/out" "no Tailscale key: skipped"
check "sudo got an empty hostname" "$REAL_GREP" -qx 'sudo -n /usr/local/sbin/klav-tailnet-up ' "$CASE/calls"
check "no tailscale, no tailscaled" test -z "$("$REAL_GREP" -E '^(tailscale|systemd-run)' "$CASE/calls" || true)"
check "only fakes ran" guard "$CASE" "printenv sudo $TAILNET_COMMANDS"
new_case "the setup line with a hostname but no key" down tagged 0
setup_bin
run_setup KLAV_TAILNET_HOSTNAME="$HOST"
check "exit 2 ($CODE)" test "$CODE" = 2
check "says why" contains "$CASE/err" "a hostname but no Tailscale key: refused"
check "no tailscale, no tailscaled" test -z "$("$REAL_GREP" -E '^(tailscale|systemd-run)' "$CASE/calls" || true)"
check "only fakes ran" guard "$CASE" "printenv sudo $TAILNET_COMMANDS"
new_case "the setup line with a tailnet" down tagged 0
setup_bin
run_setup KLAV_TAILNET_KEY="$KEY" KLAV_TAILNET_HOSTNAME="$HOST"
check "exit 0 ($CODE)" test "$CODE" = 0
check "joined" contains "$CASE/out" "on the tailnet as $HOST, with tag:klav-sandbox"
check "sudo got the hostname only" "$REAL_GREP" -qx "sudo -n /usr/local/sbin/klav-tailnet-up $HOST" "$CASE/calls"
check "up had the key file" "$REAL_GREP" -qx "$KEY_SHA" "$CASE/seen"
check "only fakes ran" guard "$CASE" "printenv sudo $TAILNET_COMMANDS"
# The key was in the setup script's environment, as Boat sets it; it is
# never an argument, and never in an output.
check "the key in no argument" lacks "$CASE/calls" "$KEY"
check "the key in no output" lacks "$CASE/out" "$KEY"
check "the key in no error" lacks "$CASE/err" "$KEY"

# Refusals before anything runs.
refusal() { # name, input, args...
	local name=$1 input=$2
	shift 2
	new_case "$name" down tagged 0
	printf '%s\n' "$input" >"$CASE/key.in"
	run_tailnet "$CASE/key.in" -- "$@"
	check "exit 2 ($CODE)" test "$CODE" = 2
