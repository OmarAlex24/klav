# A clean tree, as build-template leaves it: homes with harmless files, the
# strings' neighbors, and the three files that name the strings on purpose
# (klav-forward, klav-tailnet-up and a Debian package's tailscale), each
# matching the build record or the package's MD5 list.
clean_root() {
	local r=$1
	"$REAL_MKDIR" -p "$r/var/lib/tailscale" "$r/etc" "$r/root/.ssh" "$r/home/user/.ssh" \
		"$r/home/user/.claude" "$r/home/user/.config/gh" "$r/var/log" \
		"$r/usr/local/bin" "$r/usr/local/sbin" "$r/usr/bin" "$r/var/lib/dpkg/info" \
		"$r/etc/klav-sandbox-template"
	printf 'ssh-ed25519 AAAA test\n' >"$r/home/user/.ssh/id_ed25519.pub"
	printf 'host ssh-ed25519 AAAA\n' >"$r/home/user/.ssh/known_hosts"
	printf '{}\n' >"$r/home/user/.claude/settings.json"
	printf 'git_protocol: https\n' >"$r/home/user/.config/gh/config.yml"
	printf 'ksb2 tskey boat\n' >"$r/etc/near-misses"
	printf 'klav-forward: reads ksb1_ packages\n' >"$r/usr/local/bin/klav-forward"
	chmod 0755 "$r/usr/local/bin/klav-forward"
	"$REAL_CP" "$shipped" "$r/usr/local/sbin/klav-tailnet-up"
	chmod 0755 "$r/usr/local/sbin/klav-tailnet-up"
	printf 'tailscale: takes tskey-auth- keys\n' >"$r/usr/bin/tailscale"
	printf '%s  usr/bin/tailscale\n' "$("$REAL_MD5" <"$r/usr/bin/tailscale" | cut -d' ' -f1)" \
		>"$r/var/lib/dpkg/info/tailscale.md5sums"
	{
		printf '# klav-sandbox template klav-sandbox-0.9.0, written by build-template\n'
		printf 'KLAV_FORWARD_SHA256=%s\n' "$(sha_of "$r/usr/local/bin/klav-forward")"
		printf 'KLAV_TAILNET_UP_SHA256=%s\n' "$(sha_of "$r/usr/local/sbin/klav-tailnet-up")"
	} >"$r/etc/klav-sandbox-template/manifest"
}

