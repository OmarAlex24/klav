	fake "$1" ls "$LS_BODY"
	wrap "$1" grep "$REAL_GREP"
	wrap "$1" sha256sum "$REAL_SHA"
	wrap "$1" md5sum "$REAL_MD5"
	wrap "$1" find "$(real find)"
	wrap "$1" xargs "$(real xargs)"
