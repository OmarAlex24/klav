# Emptying the logs and removing apt's lists fail closed. rm_fails_on makes
# rm fail for any argument holding a pattern, and pass the rest to the
# guarded rm (never a permission trick: the tests may run as root).
rm_fails_on() { # pattern
	"$REAL_CP" "$CASE/bin/rm" "$CASE/rm-guarded"
	cat >"$CASE/bin/rm" <<EOF
#!$REAL_BASH
for a in "\$@"; do case \$a in *"$1"*) exit 1 ;; esac; done
exec "$CASE/rm-guarded" "\$@"
EOF
	chmod 0755 "$CASE/bin/rm"
}
