# systemctl, as check-template and build-template use it: the tailscaled
# unit's state lives in the case's `unit` file; with `mask_noop`, masking
# does nothing. `is-enabled` exits 0 only for an enabled unit, as systemd's.
# shellcheck disable=SC2016 # expanded by the fake
SYSTEMCTL_BODY='
case "$*" in
"disable --now tailscaled.service") printf "disabled\n" >"$KLAV_TEST_CASE/unit" ;;
"mask tailscaled.service") [ -e "$KLAV_TEST_CASE/mask_noop" ] || printf "masked\n" >"$KLAV_TEST_CASE/unit" ;;
"is-enabled tailscaled.service")
	u=$(cat "$KLAV_TEST_CASE/unit" 2>/dev/null || true)
	[ -z "$u" ] || printf "%s\n" "$u"
	[ "$u" = enabled ] ;;
*) exit 64 ;;
esac'
# ls: the real listing with the owner's uid from the case's `owner` file,
# 0 (root) by default: the test's files belong to whoever runs the tests.
# Without macOS's `@` (extended attributes), which Linux never prints.
# shellcheck disable=SC2016 # expanded by the fake
LS_BODY='
out=$(ls "$@") || exit
set -f
f=($out)
set +f
owner=0
[ ! -e "$KLAV_TEST_CASE/owner" ] || owner=$(cat "$KLAV_TEST_CASE/owner")
f[0]=${f[0]%@}
f[2]=$owner
printf "%s\n" "${f[*]}"'

check_bin() { # bin, pgrep exit code
	"$REAL_MKDIR" -p "$1"
	fake "$1" pgrep "exit $2"
	fake "$1" id 'echo 0'
