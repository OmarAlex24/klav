failure "a token too long" on 'answer token 200 "{\"access_token\":\"$ACCESS\"}"' 1 "held no token it could read; $NONE"
ACCESS=$SHORT_ACCESS
TKEY=$(long tskey-auth-FAKElong 4097)
failure "a key too long" on 'answer keys 200 "{\"key\":\"$TKEY\"}"' 2 "held no key it could read; $MAYBE_KEY"
TKEY=$SHORT_TKEY
# Boat: only curl's 6 and 7 on the first attempt say nothing was made.
failure "Boat unreachable on the first attempt (7)" on 'unreachable boat' 3 "could not reach Boat, or lost its answer (attempt 1, curl 7); $NONE ($UNUSED)"
failure "Boat's name unknown on the first attempt (6)" on 'curl_exit boat 6' 3 "(attempt 1, curl 6); $NONE ($UNUSED)"
failure "Boat unreachable, tailnet off" off 'unreachable boat' 1 "(attempt 1, curl 7); $NONE"
failure "Boat unreachable after a lost answer" on 'curl_exit boat.1 28; unreachable boat.2' 4 "(attempt 2, curl 7); $GOES"
failure "Boat timed out three times" on 'curl_exit boat 28' 5 "could not reach Boat, or lost its answer (attempt 3, curl 28); $GOES"
failure "Boat answered 500 three times" on 'answer boat 500 "{\"error\":\"$LEAK $BOAT_KEY $TKEY\"}"' 5 "Boat answered HTTP 500 (attempt 3); $GOES"
failure "Boat refused with a 400" on 'answer boat 400 "{\"error\":\"$LEAK\"}"' 3 "Boat answered HTTP 400 (attempt 1); $GOES"
failure "Boat refused with a 401" on 'answer boat 401 "{\"error\":\"$LEAK\"}"' 3 "HTTP 401 (attempt 1); $GOES"
failure "Boat: another body for the key (409)" on 'answer boat 409 "{\"ok\":false,\"error\":{\"code\":\"idempotency_key_reused\"}}"' 3 "HTTP 409 (attempt 1); $GOES"
failure "Boat: in progress three times" on 'answer boat 409 "{\"error\":{\"code\":\"idempotency_in_progress\"}}"' 5 "HTTP 409 (attempt 3); $GOES"
failure "Boat answered 503 then 400" on 'answer boat.1 503 "x"; answer boat.2 400 "$LEAK"' 4 "HTTP 400 (attempt 2); $GOES"
failure "Boat answered without the nested ID" on 'answer boat 202 "{\"ok\":true,\"id\":\"$BOAT_ID\",\"note\":\"$LEAK\"}"' 3 "Boat's answer held no sandbox ID it could read (HTTP 202); $GOES"
failure "Boat answered an ID that is not one" on 'answer boat 202 "{\"sandbox\":{\"id\":\"bx_x y $LEAK\"}}"' 3 "Boat's answer held no sandbox ID it could read"
failure "Boat answered an ID of another shape" on 'answer boat 202 "{\"sandbox\":{\"id\":\"sbx-FAKE-0123\"}}"' 3 "Boat's answer held no sandbox ID it could read"
failure "Boat refused, tailnet off" off 'answer boat 403 "{\"error\":\"$LEAK\"}"' 1 "HTTP 403 (attempt 1); $MAYBE"
check "  and no word about a key" lacks "$CASE/err" "Tailscale"

# 5. A signal while a call is out: one line that says what may exist, at
# once, without waiting for curl. Standard error is a pipe, as it is under
# `klav sandbox start`, which stops reading soon after the script exits: the
# pipe must close with the script, while curl is still out.
killed() { # name, endpoint that hangs, message part
	new_case "$1" on
	: >"$CASE/$2.hang"
	mkfifo "$CASE/err.pipe"
	(
		cat <"$CASE/err.pipe" >"$CASE/err"
		: >"$CASE/err.closed"
	) &
	local reader=$!
	set +e
	"$REAL_ENV" -i HOME="$CASE/home" KLAV_TEST_CASE="$CASE" PATH="$CASE/bin" \
		KLAV_SANDBOX="$PKG" KLAV_SANDBOX_CONFIG_DIR="$CFG" \
		"$bash_under_test" "$CASE/new-sandbox" </dev/null >"$CASE/out" 2>"$CASE/err.pipe" &
	local pid=$! i=0
	while [ ! -e "$CASE/$2.pid" ] && [ "$i" -lt 100 ]; do "$REAL_SLEEP" 0.1; i=$((i + 1)); done
	local start=$SECONDS
	kill -TERM "$pid"
	wait "$pid"
	CODE=$?
	local took=$((SECONDS - start))
	set -e
	# The fake curl still waits (30 s at most): the pipe closes without it.
	local closed=no
	i=0
	while [ ! -e "$CASE/err.closed" ] && [ "$i" -lt 50 ]; do "$REAL_SLEEP" 0.1; i=$((i + 1)); done
	[ ! -e "$CASE/err.closed" ] || closed=yes
	# Let the fake curl go and wait for it, so nothing is left running.
	: >"$CASE/release"
	local cpid
	cpid=$(cat "$CASE/$2.pid" 2>/dev/null || true)
	i=0
	while [ -n "$cpid" ] && kill -0 "$cpid" 2>/dev/null && [ "$i" -lt 100 ]; do "$REAL_SLEEP" 0.1; i=$((i + 1)); done
	wait "$reader" || true
	check "the call was out" test -n "$cpid"
	check "standard error closed with the script, curl still out" test "$closed" = yes
	check "exit 143 ($CODE)" test "$CODE" = 143
	check "without waiting for curl, which hangs 30 s ($took s)" test "$took" -le 10
	check "one line on standard error" one_line
	check "says what may exist" contains "$CASE/err" "$3"
	check "nothing on standard output" test ! -s "$CASE/out"
	check "no secret leaks" no_secret_leaks
	check "only fakes ran" guard
	check "the fake curl is gone" test -n "$cpid" -a -z "$(kill -0 "$cpid" 2>/dev/null && echo up)"
}
killed "killed during Boat's call" boat "stopped by TERM; $GOES"
killed "killed during the token trade" token "stopped by TERM; $NONE"
killed "killed while the key is made" keys "stopped by TERM; $MAYBE_KEY"

# 6. Refusals before any call: exit 2, nothing called.
refusal() { # name, tailnet, setup command, message part
	new_case "$1" "$2"
	eval "$3"
	run
	check "exit 2 ($CODE)" test "$CODE" = 2
	check "nothing on standard output" test ! -s "$CASE/out"
	check "one line on standard error" one_line
	check "says why" contains "$CASE/err" "$4"
	check "says no machine was made" contains "$CASE/err" "$NONE"
	check "no call" test "$(curl_calls)" = 0
	check "no secret leaks" no_secret_leaks
	check "only fakes ran" guard
}
refusal "the Boat key readable by the group" on 'chmod 0640 "$CFG/boat-api-key"' "boat-api-key is readable by others (it must be 0600): refused"
refusal "the Boat key readable by all" off 'chmod 0644 "$CFG/boat-api-key"' "boat-api-key is readable by others"
refusal "the OAuth client readable by others" on 'chmod 0604 "$CFG/tailscale-oauth"' "tailscale-oauth is readable by others"
refusal "the Boat key someone else's" on 'printf /boat-api-key >"$CASE/other-owner"' "boat-api-key belongs to another user: refused"
refusal "the Boat key a symlink" on 'mv "$CFG/boat-api-key" "$CASE/k"; ln -s "$CASE/k" "$CFG/boat-api-key"' "/cfg/boat-api-key; no Boat machine"
