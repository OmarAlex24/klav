    "Face ID changed on this iPhone, so Klav stopped using it here. Enter the master password again to delete the account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID cambió en este iPhone, así que Klav dejó de usarlo aquí. Vuelve a escribir la contraseña maestra para borrar la cuenta."
          }
        }
      }
    },
