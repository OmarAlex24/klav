              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Revoked. %lld keys are out of Klav’s reach, so they didn’t change (their vault or project is gone, or this iPhone no longer sees them)."
                }
              }
            }
          }
        },
        "es": {
