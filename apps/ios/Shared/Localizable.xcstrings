            "state": "translated",
            "value": "Ocultar"
          }
        }
      }
    },
    "Hide %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar %@"
          }
        }
      }
    },
    "Hide details": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar detalles"
          }
        }
      }
    },
    "Hide other browser folders": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar otras carpetas de navegadores"
          }
        }
      }
    },
    "Hide the notes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar las notas"
          }
        }
      }
    },
    "Hide the previous %@ of %@, %lld of %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar %1$@ anterior del %2$@, %3$lld de %4$lld"
          }
        }
      }
    },
    "Hide verification words": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar palabras de verificación"
          }
        }
      }
    },
    "Host: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Host: %@"
          }
        }
      }
    },
    "Hours": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horario"
          }
        }
      }
    },
    "Hours: %@ → %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horario: %1$@ → %2$@"
          }
        }
      }
    },
    "How long one confirmation lasts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto dura una confirmación"
          }
        }
      }
    },
    "How to export": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo exportar"
          }
        }
      }
    },
    "How to install it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo instalarla"
          }
        }
      }
    },
    "Identity": {
      "comment": "Kind of item",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Identidad"
          }
        }
      }
    },
    "If Google Authenticator is on another phone, scan each QR code with this iPhone’s camera. If it’s on this iPhone, take a screenshot of each one and choose them from Photos.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Google Authenticator está en otro teléfono, escanea cada QR con la cámara de este iPhone. Si está en este iPhone, haz una captura de cada uno y elígelas desde Fotos."
          }
        }
      }
    },
    "If the site asks for a code to finish turning on two-step verification, enter this one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el sitio pide un código para terminar de activar la verificación en dos pasos, escribe este."
          }
        }
      }
    },
    "Import": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar"
          }
        }
      }
    },
    "Import %lld items": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Import %lld item"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Import %lld items"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Importar %lld elemento"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Importar %lld elementos"
                }
              }
            }
          }
        }
      }
    },
    "Import from another app": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar desde otra app"
          }
        }
      }
    },
    "Import from somewhere else": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar desde otro sitio"
          }
        }
      }
    },
    "Import into": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar en"
          }
        }
      }
    },
    "Imported": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importado"
          }
        }
      }
    },
    "Importing…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importando…"
          }
        }
      }
    },
    "In the Bitwarden web vault, open Tools → Export vault. In the apps it’s File → Export vault, or Settings → Export vault.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la caja fuerte web de Bitwarden, abre Herramientas → Exportar caja fuerte. En las apps está en Archivo → Exportar caja fuerte, o en Ajustes → Exportar caja fuerte."
          }
        }
      }
    },
    "In the iPhone’s Settings": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del iPhone"
          }
        }
      }
    },
    "In the iPhone’s Settings, open General, then AutoFill & Passwords, and turn on Klav.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes del iPhone, abre General, luego Autorrelleno y contraseñas, y activa Klav."
          }
        }
      }
    },
    "In the simulator the key isn’t in the Secure Enclave (debug builds only).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el simulador la llave no está en el Secure Enclave (solo compilaciones de depuración)."
          }
        }
      }
    },
    "In your browser, open chrome://extensions, turn on Developer mode, choose “Load unpacked”, and pick that folder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu navegador, abre chrome://extensions, activa el modo desarrollador, elige «Cargar sin empaquetar» y selecciona esa carpeta."
          }
        }
      }
    },
    "Inject": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inyectar"
          }
        }
      }
    },
    "Inject into commands": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inyectar en comandos"
          }
        }
      }
    },
    "Inside a task": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentro de una tarea"
          }
        }
      }
    },
    "Inside the task “%@”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentro de la tarea «%@»"
          }
        }
      }
    },
    "Inspect words": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar palabras"
          }
        }
      }
    },
    "Install": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar"
          }
        }
      }
    },
    "Install Klav’s extension in each browser you chose. Until Klav is in the browser stores, download the folder here and load it in your browser.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la extensión de Klav en cada navegador que elegiste. Hasta que Klav esté en las tiendas, descarga la carpeta aquí y cárgala en tu navegador."
          }
        }
      }
    },
    "Install Klav’s extension in each browser. Until it is in the stores, load it by hand: the page says how.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la extensión de Klav en cada navegador. Hasta que esté en las tiendas, cárgala a mano: la página explica cómo."
          }
        }
      }
    },
    "Install Klav’s skill in %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar la skill de Klav en %@"
          }
        }
      }
    },
    "Install Klav’s skills in %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Klav’s skills in %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar las skills de Klav en %@"
          }
        }
      }
    },
    "Install again": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalarla otra vez"
          }
        }
      }
    },
    "Install guide": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guía de instalación"
          }
        }
      }
    },
    "Installing…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalando…"
          }
        }
      }
    },
    "Installs Klav’s skill in your agent clients’ folders, so their agents know how to use Klav. It writes no MCP settings and registers no agent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la skill de Klav en las carpetas de tus clientes de agentes, para que sus agentes sepan usar Klav. No escribe ninguna configuración MCP ni registra agentes."
          }
        }
      }
    },
    "Installs the skill": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la skill"
          }
        }
      }
    },
    "Into %@ / %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@ / %@."
          }
        }
      }
    },
    "Invite code": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de invitación"
          }
        }
      }
    },
    "Issuer %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emisor %@"
          }
        }
      }
    },
    "Issuer: %@ · %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Emisor: %1$@ · %2$@"
          }
        }
      }
    },
    "It already has their keys. With an honest server it can’t use them any more; a dishonest one could still let it open what you add there later. Changing the keys wraps those projects’ items again and gives the other agents that hold them a new grant, without asking you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tiene sus llaves. Con un servidor honrado deja de poder usarlas; uno malicioso podría dejarle abrir lo que añadas ahí después. Cambiar las llaves vuelve a envolver los elementos de esos proyectos y da un grant nuevo a los demás agentes que los tienen, sin preguntarte."
          }
        }
      }
    },
    "It came from Homebrew. To update it, run this in Terminal:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo instaló Homebrew. Para actualizarlo, escribe esto en Terminal:"
          }
        }
      }
    },
    "It came from cargo install. Install it again from the source you used, or remove it so this app’s klav runs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo instaló cargo install. Vuelve a instalarlo desde el código fuente que usaste, o quítalo para que se ejecute el klav de esta app."
          }
        }
      }
    },
    "It came from cargo install. To update it, run this in Terminal, after you update that source:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo instaló cargo install. Para actualizarlo, actualiza ese código fuente y después escribe esto en Terminal:"
          }
        }
      }
    },
    "It came from cargo install. To use this app’s klav instead, remove it in Terminal:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se instaló con cargo install. Para usar el klav de esta app, quítalo en Terminal:"
          }
        }
      }
    },
    "It cuts off its sandboxes and services at their next call.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta sus sandboxes y sus servicios en la siguiente llamada."
          }
        }
      }
    },
    "It cuts the agent off at its next request, denies its requests waiting for you and ends its tasks.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta al agente en su siguiente petición, deniega sus solicitudes pendientes y termina sus tareas."
          }
        }
      }
    },
    "It doesn’t take back what an agent already has: a process it started, a file it was given, what it read. For a stolen key, revoke and rotate.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No recupera lo que un agente ya tiene: un proceso que lanzó, un archivo que recibió, lo que leyó. Para una llave robada, revoca y rota."
          }
        }
      }
    },
    "It doesn’t undo what it already decrypted or started.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No deshace lo que ya descifró ni lo que ya lanzó."
          }
        }
      }
    },
    "It expired": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Venció"
          }
        }
      }
    },
    "It has no website: the change happens on the item’s site": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tiene sitio web: el cambio se hace en el sitio del elemento"
          }
        }
      }
    },
    "It held no project’s key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tenía la llave de ningún proyecto."
          }
        }
      }
    },
    "It held the keys of these projects, so it could read their items’ titles, usernames and addresses:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenía las llaves de estos proyectos, así que podía leer los títulos, usuarios y direcciones de sus elementos:"
          }
        }
      }
    },
    "It holds this device’s keys and the cache. To use Klav here again you sign in with your emergency kit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las llaves de este dispositivo y la caché. Para volver a usar Klav aquí, inicias sesión con tu kit de emergencia."
          }
        }
      }
    },
    "It holds your Secret Key. Print it or save it as a PDF somewhere only you can open: Klav keeps no copy, and you need it to sign in on another device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contiene tu Secret Key. Imprímelo o guárdalo como PDF donde solo tú puedas abrirlo: Klav no guarda ninguna copia, y lo necesitas para iniciar sesión en otro dispositivo."
          }
        }
      }
    },
    "It holds your passwords in plain text. Delete it wherever you saved it (the computer, Files, AirDrop’s Downloads) and empty the trash and Recently Deleted:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene tus contraseñas en texto plano. Bórrala donde la hayas guardado (la computadora, Archivos, las Descargas de AirDrop) y vacía la papelera y Eliminados recientemente:"
          }
        }
      }
    },
    "It is not a login with a password": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un login con contraseña"
          }
        }
      }
    },
    "It runs %@, the first one on the PATH this app gives klav. If your terminal finds another one first, connect from there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre %@, el primero del PATH que esta app le da a klav. Si tu terminal encuentra otro antes, conéctalo desde ahí."
          }
        }
      }
    },
    "It runs an image Klav revoked. Stop using it, then rotate the provider tokens it held.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre una imagen que Klav revocó. Deja de usarlo y luego rota los tokens de los proveedores que tenía."
          }
        }
      }
    },
    "It served an older list of approved images than this device already checked.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entregó una lista de imágenes aprobadas más antigua que la que este dispositivo ya comprobó."
          }
        }
      }
    },
    "It serves accounts of another Klav server.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atiende cuentas de otro servidor de Klav."
          }
        }
      }
    },
    "It stays": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda"
          }
        }
      }
    },
    "It stops showing on all your devices.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de aparecer en todos tus dispositivos."
          }
        }
      }
    },
    "It wasn’t confirmed that it’s you. Nothing was approved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se confirmó que eres tú. No se aprobó nada."
          }
        }
      }
    },
    "Item: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemento: %@"
          }
        }
      }
    },
    "Its attestation or its list of approved images doesn’t check out.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su atestación o su lista de imágenes aprobadas no cuadra."
          }
        }
      }
    },
    "Its list of approved images expired. That’s most likely a late release, not an attack.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su lista de imágenes aprobadas caducó. Lo más probable es una versión que se retrasó, no un ataque."
          }
        }
      }
    },
    "Its MCP settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su configuración MCP"
          }
        }
      }
    },
    "Its build: %@. This app’s: %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su compilación: %1$@. La del klav de esta app: %2$@."
          }
        }
      }
    },
    "Its own value": {
      "comment": "A variable that stores its value",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valor propio"
          }
        }
      }
    },
    "Its project is not among the agent’s projects": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su proyecto no está entre los del agente"
          }
        }
      }
    },
    "Its settings file can’t be read": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer su archivo de configuración"
          }
        }
      }
    },
    "It’s deleted on %@. Until then you can cancel it from any of your devices. Your agents stop working now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borra el %@. Hasta entonces puedes cancelarlo desde cualquiera de tus dispositivos. Tus agentes dejan de funcionar ahora."
          }
        }
      }
    },
    "It’s saved for %@. Klav filled it on %@; with this site added, it’s offered there first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está guardado para %1$@. Klav lo rellenó en %2$@; con este sitio añadido, se ofrecerá ahí primero."
          }
        }
      }
    },
    "I’ve kept it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya lo guardé"
          }
        }
      }
    },
    "Keep Klav open until it’s done. If it closes or locks, Klav picks up where it left off the next time you unlock.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja Klav abierto hasta que termine. Si se cierra o se bloquea, Klav sigue donde se quedó la próxima vez que desbloquees."
          }
        }
      }
    },
    "Keep it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservarla"
          }
        }
      }
    },
    "Keep mine": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedarme con la mía"
          }
        }
      }
    },
    "Keep the current one": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la actual"
          }
        }
      }
    },
    "Keep the development extension?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Conservar la extensión de desarrollo?"
          }
        }
      }
    },
    "Keeps the entry “%@” as Klav’s, as it is": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja la entrada «%@» como de Klav, tal como está"
          }
        }
      }
    },
    "Kept as you edited it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada como la editaste"
          }
        }
      }
    },
    "Key ID": {
      "comment": "Field name",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ID de la llave"
          }
        }
      }
    },
    "Key verified by this Mac": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llave verificada por este Mac"
          }
        }
      }
    },
    "Keys of the projects taken away left to change (%lld of %lld). Klav tries again each time you unlock.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan llaves de los proyectos retirados (%1$lld de %2$lld). Klav lo vuelve a intentar cada vez que desbloqueas."
          }
        }
      }
    },
    "Klav": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav"
          }
        }
      }
    },
    "Klav %@ wasn’t installed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav %@ no se instaló"
          }
        }
      }
    },
    "Klav asks Have I Been Pwned (api.pwnedpasswords.com) about each password. It sends only the first 5 characters of the password’s SHA-1 hash, never the password or the whole hash, and the answer is padded so its size gives nothing away. Have I Been Pwned sees your IP address and the time. This Mac only.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav pregunta a Have I Been Pwned (api.pwnedpasswords.com) por cada contraseña. Solo envía los 5 primeros caracteres del hash SHA-1 de la contraseña, nunca la contraseña ni el hash completo, y la respuesta va con relleno para que su tamaño no revele nada. Have I Been Pwned ve tu dirección IP y la hora. Solo en este Mac."
          }
        }
      }
    },
    "Klav asks Have I Been Pwned (api.pwnedpasswords.com) about each password. It sends only the first 5 characters of the password’s SHA-1 hash, never the password or the whole hash, and the answer is padded so its size gives nothing away. Have I Been Pwned sees your IP address and the time. This iPhone only.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav pregunta a Have I Been Pwned (api.pwnedpasswords.com) por cada contraseña. Solo envía los primeros 5 caracteres del hash SHA-1 de la contraseña, nunca la contraseña ni el hash completo, y la respuesta va rellenada para que su tamaño no delate nada. Have I Been Pwned ve tu dirección IP y la hora. Solo en este iPhone."
          }
        }
      }
    },
    "Klav asks for the master password every 14 days and after the iPhone restarts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav pide la contraseña maestra cada 14 días y después de reiniciar el iPhone."
          }
        }
      }
    },
    "Klav can fill in Safari and other apps now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav ya rellena en Safari y otras apps."
          }
        }
      }
    },
    "Klav can’t export your vault yet: if you want to keep something, copy it first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav todavía no exporta la bóveda: si quieres conservar algo, cópialo antes."
          }
        }
      }
    },
    "Klav can’t export your vault yet: what you don’t copy elsewhere first is lost.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav todavía no exporta tu bóveda: lo que no copies antes a otro lado se pierde."
          }
        }
      }
    },
    "Klav can’t read its record of the key changes it owes, so it can’t tell what is left. In the terminal, klav agent show %@ says why.": {
      "comment": "The argument is the agent ID, part of a terminal command: keep it as is.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no puede leer su registro de los cambios de llave pendientes, así que no sabe qué falta. En la terminal, klav agent show %@ dice por qué."
          }
        }
      }
    },
    "Klav can’t read its record of the key changes it owes, so it can’t tell what is left: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no puede leer su registro de los cambios de llave pendientes, así que no sabe qué falta: %@"
          }
        }
      }
    },
    "Klav can’t read this link. It saves time-based codes (TOTP).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no puede leer este enlace. Guarda códigos por tiempo (TOTP)."
          }
        }
      }
    },
    "Klav can’t read what it saw right now (%@). Revoking still works.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no puede leer ahora qué vio (%@). Revocarlo funciona igual."
          }
        }
      }
    },
    "Klav can’t tell right now how many sandboxes this covers. Every sandbox the proxy with ID %@ has issued so far gets no access from its next call, and the conversations working in them stop. Their issuers can start others; to stop that, pause agents. Nothing asks for Touch ID, and there is no undo.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no puede saber ahora cuántos sandboxes cubre. Todos los sandboxes que el proxy con ID %@ ha emitido hasta ahora se quedan sin acceso desde su siguiente llamada, y las conversaciones que trabajan en ellos se detienen. Sus emisores pueden lanzar otros; para evitarlo, pausa los agentes. No se pide Touch ID y no se puede deshacer."
          }
        }
      }
    },
    "Klav can’t use the camera. Turn it on in the iPhone’s Settings › Klav, or choose screenshots instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no puede usar la cámara. Actívala en Ajustes del iPhone › Klav, o elige capturas."
          }
        }
      }
    },
    "Klav changed the keys of the projects taken away that it can reach; %lld are out of its reach.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Klav changed the keys of the projects taken away that it can reach; %lld is out of its reach."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Klav changed the keys of the projects taken away that it can reach; %lld are out of its reach."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Klav cambió las llaves de los proyectos retirados que tiene a su alcance; %lld quedó fuera."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Klav cambió las llaves de los proyectos retirados que tiene a su alcance; %lld quedaron fuera."
                }
              }
            }
          }
        }
      }
    },
    "Klav checks them on this Mac; nothing leaves it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav las revisa en este Mac; nada sale de él."
          }
        }
      }
    },
    "Klav Cloud": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav Cloud"
          }
        }
      }
    },
    "Klav Cloud can run your credential proxy in an attested enclave, so sandboxes keep working while your devices are off.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav Cloud puede correr tu proxy de credenciales en un enclave atestado, para que los sandboxes sigan funcionando con tus dispositivos apagados."
          }
        }
      }
    },
    "Klav Cloud’s proxy": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proxy de Klav Cloud"
          }
        }
      }
    },
    "Klav Cloud’s proxy agent is revoked or gone. Stop using it, or set it up again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente del proxy de Klav Cloud está revocado o ya no existe. Deja de usarlo o vuelve a configurarlo."
          }
        }
      }
    },
    "Klav Cloud’s proxy can’t be checked right now. Nothing new is shared with it until it can.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no se puede comprobar el proxy de Klav Cloud. No se le comparte nada nuevo hasta que se pueda."
          }
        }
      }
    },
    "Klav Cloud’s proxy couldn’t be verified. Klav won’t share new credentials with it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el proxy de Klav Cloud. Klav no le compartirá credenciales nuevas."
          }
        }
      }
    },
    "Klav Cloud’s proxy lost its keys. Set it up again to keep using your credentials from sandboxes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proxy de Klav Cloud perdió sus llaves. Vuelve a configurarlo para seguir usando tus credenciales desde los sandboxes."
          }
        }
      }
    },
    "Klav couldn’t check for generated passwords or passkeys that never reached your account: if you delete this copy, any are lost.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no pudo comprobar si hay contraseñas generadas o passkeys que nunca llegaron a tu cuenta: si borras esta copia, las que haya se pierden."
          }
        }
      }
    },
    "Klav couldn’t check for passkeys or generated passwords that aren’t uploaded yet: if you sign out, any are lost. Connect to the internet and open Klav to upload them first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no pudo comprobar si hay passkeys o contraseñas generadas sin subir: si sales, las que haya se pierden. Conéctate a internet y abre Klav para subirlas antes."
          }
        }
      }
    },
    "Klav couldn’t count the items in those projects; it wraps all of their keys again, with their stored versions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no pudo contar los elementos de esos proyectos; vuelve a envolver todas sus llaves, con sus versiones guardadas."
          }
        }
      }
    },
    "Klav couldn’t keep it in the generator history: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no pudo guardarla en el historial del generador: %@"
          }
        }
      }
    },
    "Klav couldn’t open its data": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no pudo abrir sus datos"
          }
        }
      }
    },
    "Klav couldn’t pause the agents: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no pudo pausar los agentes: %@"
          }
        }
      }
    },
    "Klav couldn’t read every agent’s grant: any other agent that holds these projects also gets one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no pudo leer el grant de todos los agentes: cualquier otro que tenga estos proyectos también recibe uno nuevo."
          }
        }
      }
    },
    "Klav couldn’t read this agent’s permissions: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no pudo leer los permisos de este agente: %@"
          }
        }
      }
    },
    "Klav couldn’t remove these files; delete them to stop the development extension: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no pudo quitar estos archivos; bórralos para cortar la extensión de desarrollo: %@"
          }
        }
      }
    },
    "Klav couldn’t verify the sandbox list, so it doesn’t show the last list it read, which may no longer be true.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no pudo verificar la lista de sandboxes, así que no muestra la última lista que leyó, que puede ya no ser cierta."
          }
        }
      }
    },
    "Klav deleted your account": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav borró tu cuenta"
          }
        }
      }
    },
    "Klav deleted your account, so this copy can’t save anything new.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav borró tu cuenta, así que esta copia ya no guarda nada nuevo."
          }
        }
      }
    },
    "Klav deleted your account. This Mac’s copy opens read-only.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav borró tu cuenta. La copia de este Mac se abre en solo lectura."
          }
        }
      }
    },
    "Klav deletes everything your account has on the server: your vaults with their items, versions and files, your devices, your agents and the audit log.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav borra del servidor todo lo de tu cuenta: tus bóvedas con sus elementos, versiones y archivos, tus dispositivos, tus agentes y la bitácora."
          }
        }
      }
    },
    "Klav denied %lld of its attempts.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Klav denied %lld of its attempts."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Klav denied %lld of its attempts."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Klav le negó %lld intento."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Klav le negó %lld intentos."
                }
              }
            }
          }
        }
      }
    },
    "Klav doesn’t fill them until you confirm them. Confirm only sites you know are this login’s.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no rellena en ellos hasta que los confirmes. Confirma solo los sitios que sepas que son de este inicio de sesión."
          }
        }
      }
    },
    "Klav doesn’t read the file Twilio sends on a data request: its codes are encrypted with a scheme Twilio doesn’t document.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no lee el archivo que Twilio manda si pides tus datos: sus códigos van cifrados con un esquema que Twilio no documenta."
          }
        }
      }
    },
    "Klav doesn’t take the site from the link. Type it so Klav can fill in the code in Safari and other apps.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav no toma el sitio del enlace. Escríbelo para que Klav pueda rellenar el código en Safari y en otras apps."
          }
        }
      }
    },
    "Klav emergency kit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kit de emergencia de Klav"
          }
        }
      }
    },
    "Klav fills in now": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav ya rellena"
          }
        }
      }
    },
    "Klav hasn’t generated any password yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav aún no ha generado ninguna contraseña."
          }
        }
      }
    },
    "Klav is locked": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav está bloqueado"
          }
        }
      }
    },
    "Klav is locked.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav está bloqueado."
          }
        }
      }
    },
    "Klav is off in iOS Settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav está desactivado en Ajustes de iOS"
          }
        }
      }
    },
    "Klav is off this Mac": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav ya no está en este Mac"
          }
        }
      }
    },
    "Klav is on in iOS Settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav está activado en Ajustes de iOS"
          }
        }
      }
    },
    "Klav is on. Safari and other apps can fill with it now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav está activado. Safari y las demás apps ya pueden rellenar con él."
          }
        }
      }
    },
    "Klav is telling the server.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav se lo está diciendo al servidor."
          }
        }
      }
    },
    "Klav is updated on every device, and klav-proxy too": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav está actualizado en todos mis dispositivos, y klav-proxy también"
          }
        }
      }
    },
    "Klav isn’t set up on this Mac yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav aún no está configurado en este Mac."
          }
        }
      }
    },
    "Klav keeps it on this iPhone. Open Klav to sync this passkey to your other devices.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav la guarda en este iPhone. Abre Klav para sincronizar esta passkey con tus otros dispositivos."
          }
        }
      }
    },
    "Klav keeps your vault in klavd, a small background service that the browser extension, the CLI and this app share. Each step says what it changes before it does.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav guarda tu bóveda en klavd, un pequeño servicio en segundo plano que comparten la extensión del navegador, la CLI y esta app. Cada paso dice qué cambia antes de hacerlo."
          }
        }
      }
    },
    "Klav limits how often the deletion can be asked for. Try again later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav limita cuántas veces se puede pedir el borrado. Vuelve a intentarlo más tarde."
          }
        }
      }
    },
    "Klav looks for its projects in what your account signed, then wraps their items’ keys again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav busca sus proyectos en lo que firmó tu cuenta y vuelve a envolver las llaves de sus elementos."
          }
        }
      }
    },
    "Klav makes a Secret Key on this Mac. Together with your master password, it is the only way into your vault: nobody can reset either of them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav crea una Secret Key en este Mac. Junto con tu contraseña maestra, es la única forma de entrar en tu bóveda: nadie puede restablecer ninguna de las dos."
          }
        }
      }
    },
    "Klav menu": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menú de Klav"
          }
        }
      }
    },
    "Klav needs the master password to show this.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav necesita la contraseña maestra para mostrar esto."
          }
        }
      }
    },
    "Klav no longer reads your old passkey setting: passkeys now ask every time. Choose again in the extension’s settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav ya no lee tu antiguo ajuste de passkeys: ahora las passkeys piden confirmación cada vez. Vuelve a elegirlo en los ajustes de la extensión."
          }
        }
      }
    },
    "Klav only fills on the sites saved in each item. Add this site from the app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav solo rellena en los sitios guardados en cada elemento. Agrega este sitio desde la app."
          }
        }
      }
    },
    "Klav opens in the menu bar when you log in, without a window. klavd starts at login either way: it’s the background service.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al iniciar sesión, Klav se abre en la barra de menús, sin ninguna ventana. klavd arranca al iniciar sesión de todas formas: es el servicio en segundo plano."
          }
        }
      }
    },
    "Klav reads the columns title (or name), url, username, password, notes, totp and tags.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav lee las columnas title (o name), url, username, password, notes, totp y tags."
          }
        }
      }
    },
    "Klav revoked %@ and the server answered, but the verified log doesn’t have that revocation: it may still have access. Klav checks again on every read. To cut it now, pause agents or revoke the proxy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav revocó %@ y el servidor respondió, pero la bitácora verificada no tiene esa revocación: puede que aún tenga acceso. Klav lo vuelve a comprobar en cada lectura. Para cortarlo ya, pausa los agentes o revoca el proxy."
          }
        }
      }
    },
    "Klav revoked every sandbox of your proxy and the server answered, but the verified log doesn’t have that revocation: they may still have access. Klav checks again on every read. To cut them now, pause agents or revoke the proxy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav revocó todos los sandboxes de tu proxy y el servidor respondió, pero la bitácora verificada no tiene esa revocación: puede que aún tengan acceso. Klav lo vuelve a comprobar en cada lectura. Para cortarlos ya, pausa los agentes o revoca el proxy."
          }
        }
      }
    },
    "Klav skill": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Skill de Klav"
          }
        }
      }
    },
    "Klav skills": {
