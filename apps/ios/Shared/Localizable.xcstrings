    "%@ already exists (%@). Replace it with a link to this app’s klav?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya existe (%2$@). ¿Lo reemplazo por un enlace al klav de esta app?"
          }
        }
      }
    },
    "%@ already has a one-time code. Replacing it removes the code Klav has for this login. Do it only if the site just gave you this new one.": {
      "comment": "The login's title",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya tiene un código de un solo uso. Reemplazarlo quita el código que Klav tiene para este login. Hazlo solo si el sitio te acaba de dar este nuevo."
          }
        }
      }
    },
    "%@ already has a passkey for this account. The new one replaces it, and the old one stops working.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya tiene una passkey para esta cuenta. La nueva la reemplaza y la anterior deja de funcionar."
          }
        }
      }
    },
    "%@ already has this code": {
      "comment": "Title after saving; the login's title",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya tiene este código"
          }
        }
      }
    },
    "%@ already has this code. Nothing changes.": {
      "comment": "The login's title",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
