    "%lld generated passwords are not uploaded yet: if you sign out, they’re lost. Copy them from the generator history, or connect to the internet and open Klav to upload them first.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld generated password is not uploaded yet: if you sign out, it’s lost. Copy it from the generator history, or connect to the internet and open Klav to upload it first."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld generated passwords are not uploaded yet: if you sign out, they’re lost. Copy them from the generator history, or connect to the internet and open Klav to upload them first."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Hay %lld contraseña generada sin subir: si sales, se pierde. Cópiala desde el historial del generador, o conéctate a internet y abre Klav para subirla antes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Hay %lld contraseñas generadas sin subir: si sales, se pierden. Cópialas desde el historial del generador, o conéctate a internet y abre Klav para subirlas antes."
                }
              }
            }
          }
        }
      }
    },
