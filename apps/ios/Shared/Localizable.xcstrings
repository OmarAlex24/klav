    "Klav was already unlocked elsewhere. Your master password still counted as this app’s confirmation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav ya estaba desbloqueado en otro lugar. Tu contraseña maestra contó igualmente como la confirmación de esta app."
          }
        }
      }
    },
    "Klav was already unlocked elsewhere; this unlock gave this app nothing. If you didn’t unlock it, lock Klav.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav ya estaba desbloqueado en otro lugar; este desbloqueo no le dio nada a esta app. Si no lo desbloqueaste tú, bloquea Klav."
          }
        }
      }
    },
    "Klav uses Face ID here; the master password is only typed in the app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav usa Face ID aquí; la contraseña maestra solo se escribe en la app."
