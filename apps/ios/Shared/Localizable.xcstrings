        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills de Klav"
          }
        }
      }
    },
    "Klav stopped changing keys because it made no progress. It tries again the next time you unlock.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav dejó de cambiar llaves porque no avanzaba. Lo vuelve a intentar la próxima vez que desbloquees."
          }
        }
      }
    },
    "Klav takes off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Klav quita"
          }
        }
      }
