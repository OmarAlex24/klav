            "state": "translated",
            "value": "Ir"
          }
        }
      }
    },
    "Got it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendido"
          }
        }
      }
    },
    "Has a klav entry Klav didn’t write": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene una entrada klav que Klav no escribió"
          }
        }
      }
    },
    "Has access": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene acceso"
          }
        }
      }
    },
    "Has another code": {
      "comment": "A login that already has a different one-time code",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene otro código"
          }
        }
      }
    },
    "Has this code": {
      "comment": "A login that already has the link's one-time code",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene este código"
          }
        }
      }
    },
    "Hidden": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculto"
          }
        }
      }
    },
    "Hide": {
      "localizations": {
        "es": {
