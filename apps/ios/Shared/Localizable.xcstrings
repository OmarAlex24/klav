          "stringUnit": {
            "state": "translated",
            "value": "Logins"
          }
        }
      }
    },
    "Logins for the same site and user become one item. When their passwords differ, the newer one stays and the other goes to the item’s password history: no password is lost.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los logins del mismo sitio y usuario quedan en un solo elemento. Si sus contraseñas no coinciden, se queda la más nueva y la otra pasa al historial de contraseñas del elemento: no se pierde ninguna."
          }
        }
      }
    },
