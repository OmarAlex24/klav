{
  "name": "@klav/extension",
  "version": "0.9.1",
  "description": "Klav browser extension (Chromium and Firefox, Manifest V3)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "build": "node scripts/build-wasm.mjs && node scripts/build.mjs --zip",
    "build:fast": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint:firefox": "node scripts/lint-firefox.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "addons-linter": "^10.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
