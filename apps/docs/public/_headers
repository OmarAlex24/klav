# Headers on every response. One /* rule only: a second /* rule replaces this
# one instead of adding to it (checked with wrangler dev).
#
# Security headers matching apps/web where they apply to a static site
# (docs/sitio-web.md §2 and §7):
# - nosniff, no referrer, no framing, its own browsing context group, and none
#   of the browser features the site never uses;
# - HSTS without includeSubDomains or preload: from this host they would only
#   cover its own subdomains, which don't exist; klav.dev (apps/web) already
#   sends includeSubDomains for the whole domain;
# - a CSP with no 'unsafe-inline' for scripts. The two inline scripts are the
#   theme (src/layouts/BaseLayout.astro) and the sidebar's scroll restore
#   (src/layouts/DocsLayout.astro); tools/check-csp.mjs fails the build check
#   when an inline script's hash isn't listed here, so an upgrade that changes
#   one says so. 'wasm-unsafe-eval' and worker-src are Pagefind's search (a
#   WebAssembly module in a worker). Styles keep 'unsafe-inline': Astro's view
#   transitions and Nimbus's sidebar write inline styles and style attributes.
# - No Cross-Origin-Resource-Policy: llms.txt, the .md pages and og.png are
#   meant to be read from other sites.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-XmtM+hVHbc3vWZ+Q32gnTlb34D7ViN7ppNL7BaepRaQ=' 'sha256-mSebh4jKfTGZe0aXW6jkI1rRqy8yxzx166hdigYEOd4='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# Hashed build files never change, so browsers keep them for a year without
# asking again. Hosts that don't read _headers ignore this file.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The authored source of each page (ADR 0039 §4), served as UTF-8 Markdown.
# Nimbus's generated block below sets the type of /llms.txt, /llms-full.txt,
# robots.txt and the .md pages, but not of the .mdx ones.
/index.mdx
  Content-Type: text/markdown; charset=utf-8

/*/index.mdx
  Content-Type: text/markdown; charset=utf-8
